{
  "redirects": [
    { "source": "/app.html", "destination": "/", "permanent": true },
    { "source": "/app", "destination": "/", "permanent": true },
    { "source": "/favicon.ico", "destination": "/assets/icons/favicon.ico", "permanent": true },
    { "source": "/apple-touch-icon.png", "destination": "/assets/icons/apple-touch-icon.png", "permanent": true },
    { "source": "/og-image.png", "destination": "/assets/icons/og-image.png", "permanent": true },
    { "source": "/logo-email.png", "destination": "/assets/icons/logo-email.png", "permanent": true }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" }]
    },
    {
      "source": "/horaires/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/aide/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/dist/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/logos/ecoles/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000" }]
    },
    {
      "source": "/assets/icons/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/assets/icons/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
