# Configuration locale EzHoraire
# Copiez ce fichier vers .env.local et renseignez vos valeurs de test.
# Ne committez JAMAIS .env.local

SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique

# Dashboard admin (/dashboard.html + /api/stats) — ne JAMAIS exposer au navigateur.
# Service role : Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# Admins — au moins une des deux listes :
# 1) ADMIN_USER_IDS (recommandé) : UUID des comptes, visibles dans
#    Supabase → Authentication → Users. Impossible à réclamer par un tiers.
# 2) ADMIN_EMAILS : emails séparés par des virgules (repli ; ne vaut que
#    tant que les comptes existent déjà).
# Alternative aux deux : mettre "admin": true dans app_metadata du compte
# (Authentication → Users → Edit), modifiable uniquement côté serveur.
ADMIN_USER_IDS=
ADMIN_EMAILS=toi@exemple.be

# Notifications bug / demande via Resend — un email à chaque nouveau report.
# RESEND_API_KEY : clé depuis https://resend.com/api-keys (Production).
# BUGS_NOTIFY_TO : ton adresse perso (jamais codée en dur, le dépôt est public).
# BUGS_NOTIFY_FROM (optionnel) : doit appartenir à un domaine vérifié chez
# Resend — défaut "EzHoraire <contact@ezhoraire.be>".
# Sans ces variables, aucun mail ne part (le report reste enregistré).
RESEND_API_KEY=
BUGS_NOTIFY_TO=toi@exemple.be
# BUGS_NOTIFY_FROM=EzHoraire <contact@ezhoraire.be>

# Jev (TypeSafe) — import d'une liste de cours par capture/copier-coller.
# Clé à créer sur https://console.typesafe.ai/settings/keys ; reste côté serveur.
TYPESAFE_API_KEY=
