# Vérification de domaine Discord (token public, pas de secret, mais
# propre au compte : ne pas versionner)
.well-known/discord

# État local du CLI Supabase (ref projet liée, pas de secrets)
supabase/.temp/

# Plans et notes locales (non versionnés)
dashboard.md

# Captures d'écran de travail (jamais versionnées)
.cache/

# Artefacts écrits par `vercel build` (le constructeur Python les
# régénère à chaque fois, en local comme chez l'hébergeur).
/pyproject.toml
/uv.lock
/.python-version

# Brouillons de logos (scripts jetables, chemins propres à cette machine)
tests/*.py
logos/propositions/*.py
lab/propositions/*.py
seo/rapports-seo/
node_modules/
