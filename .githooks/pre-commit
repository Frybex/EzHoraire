#!/bin/sh
# Trois vérifications avant chaque commit. Activer une fois :
#   git config core.hooksPath .githooks
#
# 1. sitemap.xml : un <lastmod> doit refléter la dernière modification
#    de sa page.
sortie=$(python3 tools/maj_sitemap.py --check 2>&1)
if [ $? -ne 0 ]; then
    printf '%s\n' "$sortie" >&2
    echo "Commit refusé : lancez « python3 tools/maj_sitemap.py », ajoutez sitemap.xml, puis relancez le commit." >&2
    exit 1
fi
# 2. assets/dist/ : le bundle minifié doit être reconstruit dès qu'une
#    source change (l'hébergeur sert l'arbre tel quel, sans build).
sortie=$(python3 tools/build_assets.py --check 2>&1)
if [ $? -ne 0 ]; then
    printf '%s\n' "$sortie" >&2
    echo "Commit refusé : lancez « python3 tools/build_assets.py », ajoutez assets/dist/ et les pages réécrites, puis relancez le commit." >&2
    exit 1
fi
# 3. Empreintes CSP : la liste des scripts embarqués doit correspondre aux
#    pages (sinon le thème est bloqué en ligne, sans avertissement).
sortie=$(python3 tools/valider_csp.py 2>&1)
if [ $? -ne 0 ]; then
    printf '%s\n' "$sortie" >&2
    echo "Commit refusé : lancez « python3 tools/valider_csp.py --write », ajoutez vercel.json et tools/serve.py, puis relancez le commit." >&2
    exit 1
fi
